<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yaozhidao.mapper.UserDrugBoxMapper">

    <insert id="insert">
        INSERT INTO user_drug_box (user_id, drug_id) VALUES (#{userId}, #{drugId})
    </insert>

    <select id="count" resultType="int">
        SELECT COUNT(*) FROM user_drug_box WHERE user_id = #{userId} AND drug_id = #{drugId}
    </select>

</mapper>
